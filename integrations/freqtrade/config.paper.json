{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "dry_run": true,
  "dry_run_wallet": 10,
  "trading_mode": "spot",
  "margin_mode": "",
  "stake_currency": "USDT",
  "stake_amount": "unlimited",
  "tradable_balance_ratio": 0.99,
  "max_open_trades": 2,
  "timeframe": "15m",
  "exchange": {
    "name": "kraken",
