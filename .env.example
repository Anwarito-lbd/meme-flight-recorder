# The application refuses any execution mode except paper.
MFR_EXECUTION_MODE=paper
MFR_DATABASE_PATH=data/flight_recorder.db
MFR_STARTING_EQUITY_USD=10

# Optional read-only providers
COINGECKO_API_KEY=
COINGECKO_API_PLAN=demo
HELIUS_API_KEY=
# Optional alternative to HELIUS_API_KEY. Never commit a URL containing a key.
SOLANA_RPC_URL=

# Optional alerts (not implemented in the core MVP)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
